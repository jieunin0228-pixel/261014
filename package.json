{
  "name": "coverage-analyzer",
  "version": "0.1.0",
  "private": true,
  "description": "보험 약관 PDF에서 담보를 분류하고 ECS 룰 입력 참고 초안을 만드는 로컬 웹앱",
  "main": "server/index.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test test/*.test.js",
    "build:sample": "node scripts/build-sample-pdf.js",
    "check:ui": "node scripts/ui-check.js"
  },
  "dependencies": {
    "express": "5.2.1",
    "pdfjs-dist": "4.10.38"
  }
}
